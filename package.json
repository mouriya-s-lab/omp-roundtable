{
  "name": "omp-roundtable",
  "version": "0.1.0",
  "description": "Round-table delivery for Oh My Pi: seats hold identity tickets derived from a local agenda state and GitHub facts.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "omp"],
  "files": ["index.ts", "src/", "docs/", "README.md", "LICENSE"],
  "omp": {
    "extensions": ["./index.ts"],
    "settings": {
      "recomputeIntervalSeconds": {
        "type": "number",
        "description": "Timer recompute interval in seconds (design Q7).",
        "default": 120,
        "min": 1,
        "env": "OMP_ROUNDTABLE_RECOMPUTE_SECONDS"
      },
      "dataDir": {
        "type": "string",
        "description": "Directory of the agenda state files (<dataDir>/state). Default: <agent dir>/omp-roundtable.",
        "env": "OMP_ROUNDTABLE_DIR"
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "18.4.2",
    "@oh-my-pi/pi-coding-agent": "18.4.2",
    "@oh-my-pi/pi-utils": "18.4.2",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
